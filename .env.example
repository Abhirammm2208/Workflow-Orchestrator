# =============================================================================
# Customer Support Issue Triage — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — Nvidia Nemotron (via OpenAI-compatible API on build.nvidia.com)
# Get your key at: https://build.nvidia.com/
# Model: nvidia/llama-3.3-nemotron-super-49b-v1  (or nemotron-4-340b-instruct)
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# -----------------------------------------------------------------------------
# PostgreSQL — Main application database
# Used by: SQLAlchemy ORM (asyncpg driver) for run metadata
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Abhiram@123
POSTGRES_DB=Workflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy async URL (asyncpg driver — used by ORM)
# NOTE: Special characters in password must be URL-encoded (@ → %40). Use 127.0.0.1 not localhost.
DATABASE_URL=postgresql+asyncpg://postgres:Abhiram%40123@127.0.0.1:5432/Workflow

# Psycopg3 sync/async URL (psycopg driver — used by LangGraph AsyncPostgresSaver)
PSYCOPG_URL=postgresql+psycopg://postgres:Abhiram%40123@127.0.0.1:5432/Workflow

# Raw psycopg3 DSN (used directly by AsyncPostgresSaver, no driver prefix)
CHECKPOINT_DB_URI=postgresql://postgres:Abhiram%40123@127.0.0.1:5432/Workflow

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-32-char-secret

# -----------------------------------------------------------------------------
# Workflow Settings
# -----------------------------------------------------------------------------
# Maximum retry attempts for a failed run before marking as permanently failed
MAX_RETRY_ATTEMPTS=3

# LLM request timeout in seconds
LLM_TIMEOUT_SECONDS=30

# Whether to use mock LLM responses (true = skip real API calls, good for testing)
USE_MOCK_LLM=true
