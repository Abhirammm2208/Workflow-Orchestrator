# =============================================================================
# .dockerignore — keeps the build context lean and secrets out of the image
# =============================================================================

# Secrets — never bake these into the image
.env
*.pem
*.key

# Git
.git/
.gitignore

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Test/IDE artefacts
.pytest_cache/
.coverage
htmlcov/
.vscode/
.idea/
*.swp
*~

# Logs
*.log
logs/

# Docker volumes (don't re-copy data into the image)
postgres_data/

# Documentation (not needed inside the container)
*.md
Architecture.md
Project.md
AGENT_WORKFLOW.md
README.md
